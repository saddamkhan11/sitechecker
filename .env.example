# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# AI provider: auto = Groq if GROQ_API_KEY is set, otherwise OpenAI if OPENAI_API_KEY is set.
AI_PROVIDER=auto
# Groq (https://console.groq.com/keys): chat agent, photo checks and Urdu speech-to-text
GROQ_API_KEY=
GROQ_MODEL_CHAT=openai/gpt-oss-120b
GROQ_MODEL_VISION=qwen/qwen3.8-27b
GROQ_MODEL_STT=whisper-large-v3
# Backup chat model (its own daily quota) used when the main one is used up; empty = no backup
GROQ_MODEL_CHAT_FALLBACK=qwen/qwen3.8-27b
# Longest rate-limit wait inside one reply, in seconds
AI_MAX_WAIT_SECONDS=30
# Raise on every release so phones load the new CSS/JS instead of a cached copy
STATIC_VERSION=5
# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=gpt-4.1-mini
OPENAI_MODEL_VISION=gpt-4.1-mini
OPENAI_MODEL_STT=whisper-1
AGENT_MAX_STEPS=8
VOICE_MAX_SECONDS=60
AI_DAILY_LIMIT_PER_USER=60
PHOTO_MIN_CONFIDENCE=0.6
# Leave empty on a laptop: Celery tasks then run inline.
REDIS_URL=
# Set these to use PostgreSQL instead of SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
# Production photo storage (django-storages, S3-compatible)
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
